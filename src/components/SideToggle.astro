---
interface Props {
  floating?: boolean;
}
const { floating = false } = Astro.props;
---

<button
  id={floating ? "float-toggle" : "side-toggle"}
  class={floating ? "float-toggle" : "side-toggle"}
  type="button"
  aria-pressed="false"
  aria-label="明暗切换"
  data-toggle
>
  <svg class="taiji" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="48" fill="#f4f7f5" stroke="#14201b" stroke-width="1.5"></circle>
    <path fill="#14201b" d="M50 2a48 48 0 0 0 0 96 24 24 0 0 0 0-48 24 24 0 0 1 0-48z"></path>
    <circle cx="50" cy="26" r="6.5" fill="#14201b"></circle>
    <circle cx="50" cy="74" r="6.5" fill="#f4f7f5"></circle>
  </svg>
  {
    !floating && (
      <span>
        <span class="side-name only-light">明史</span>
        <span class="side-name only-dark">暗史</span>
        <span class="side-hint only-light">翻到暗史</span>
        <span class="side-hint only-dark">翻回明史</span>
      </span>
    )
  }
</button>
