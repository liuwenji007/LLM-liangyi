---
interface Props {
  floating?: boolean;
}
const { floating = false } = Astro.props;
---

<button
  id={floating ? "float-toggle" : "side-toggle"}
  class={floating ? "float-toggle" : "side-toggle"}
  type="button"
  aria-pressed="false"
  aria-label="明暗切换"
  data-toggle
>
  <svg class="taiji" viewBox="0 0 100 100" aria-hidden="true"><use href="#taiji"></use></svg>
  {
    !floating && (
      <span>
        <span class="side-name only-light">明史</span>
        <span class="side-name only-dark">暗史</span>
        <span class="side-hint only-light">翻到暗史</span>
        <span class="side-hint only-dark">翻回明史</span>
      </span>
    )
  }
</button>
